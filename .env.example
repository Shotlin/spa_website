# Browser-safe Supabase configuration. Copy this to .env.local for local work
# and set the same values in Vercel's Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Compatibility fallback for older Supabase projects. Leave this empty when
# using the publishable key above.
VITE_SUPABASE_ANON_KEY=

# Used for Auth redirect URLs.
VITE_SITE_URL=http://localhost:5173

# Never put a privileged server key in a VITE_ variable or in this file.
